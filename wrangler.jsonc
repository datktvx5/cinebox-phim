{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cinebox-phim",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-10",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/admin"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "cinebox-db", "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE" }
  ]
}
